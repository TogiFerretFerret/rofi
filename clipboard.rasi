* {
  font:   "JetBrainsMono Nerd Font 12";
  bg0     : rgba(15, 15, 22, 0.88);
  bg1     : rgba(15, 15, 22, 0.92);
  bg2     : rgba(255, 255, 255, 0.04);
  bg3     : rgba(255, 255, 255, 0.08);
  fg0     : #e1e2e9;
  fg1     : rgba(225, 226, 233, 0.7);
  fg2     : rgba(225, 226, 233, 0.4);
  accent  : #a3c9ff;
  urgent  : #f38ba8;
  border0 : rgba(255, 255, 255, 0.08);

  background-color : transparent;
  text-color       : @fg0;

  margin  : 0;
  padding : 0;
  spacing : 0;
}

element-icon, element-text, scrollbar {
  cursor: pointer;
}

window {
  location : center;
  anchor: center;
  width    : 1000px;
  x-offset : 4px;
  y-offset : 26px;

  background-color: @bg1;
  border: 1px;
  border-color: @border0;
  border-radius: 16px;
}

inputbar {
  spacing  : 8px;
  padding  : 8px 12px;
  children : [ icon-search, entry ];

  background-color: @bg0;
  border-radius: 16px 16px 0 0;
}

icon-search, entry, element-icon, element-text {
  vertical-align: 0.5;
}

icon-search {
  expand   : false;
  filename : "search-symbolic";
  size     : 14px;
}

entry {
  placeholder       : "Search clipboard...";
  placeholder-color : @fg2;
}

textbox {
  padding          : 4px 8px;
  background-color : @bg2;
}

listview {
  padding      : 6px 0px;
  lines        : 12;
  columns      : 1;
  scrollbar    : true;
  fixed-height : false;
  dynamic      : true;
}

element {
  padding : 8px 12px;
  spacing : 8px;
  border-radius: 8px;
  margin: 2px 6px;
}

element normal urgent {
  text-color: @urgent;
}

element normal active {
  text-color: @accent;
}

element alternate active {
  text-color: @accent;
}

element selected {
  text-color       : @bg1;
  background-color : @accent;
}

element selected urgent {
  background-color: @urgent;
}

element-icon {
  size: 0.8em;
}

element-text {
  text-color: inherit;
}

scrollbar {
  handle-width : 4px;
  handle-color : @fg2;
  padding      : 0 4px;
}
